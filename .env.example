# Copia este archivo a .env y completa los valores.
# .env esta en .gitignore; no se sube al repositorio.

# === Cosmos DB (para ingest_cosmos.py) ===
# Opcion A: URL completa
COSMOS_ENDPOINT=https://TU_CUENTA.documents.azure.com:443/
# Opcion B: solo nombre de cuenta
# AZURE_COSMOSDB_ACCOUNT=TU_CUENTA

COSMOS_DATABASE=ecommerce_db
COSMOS_SERVICIOS_CONTAINER=servicios

# === Azure AI Search (para ingest_search.py) ===
SEARCH_ENDPOINT=https://TU_SERVICIO.search.windows.net
# o: AZURE_SEARCH_ENDPOINT / AZURE_AI_SEARCH_ENDPOINT

# === Azure OpenAI (para embeddings en ingest_search.py) ===
AOAI_ENDPOINT=https://TU_RECURSO.openai.azure.com/
# o: AZURE_OPENAI_ENDPOINT

AOAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
# o: AZURE_OPENAI_EMBEDDING_MODEL

# === Opcional ===
SEARCH_INDEX=servicios_index
AZURE_OPENAI_API_VERSION=2024-02-15-preview
